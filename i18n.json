{
  "version": 1.8,
  "locale": {
    "source": "en",
    "targets": [
      "es",
      "fr",
      "de",
      "ja",
      "zh",
      "pt",
      "ar",
      "ru",
      "it",
      "ko"
    ]
  },
  "buckets": {
    "json": {
      "include": [
        "apps/dashboard/locales/[locale].json",
        "apps/docs-lanonasis/locales/[locale].json",
        "apps/lanonasis-index/locales/[locale].json",
        "apps/lanonasis-maas/locales/[locale].json",
        "apps/onasis-core/locales/[locale].json",
        "apps/vortexai-l0/locales/[locale].json",
        "packages/memory-sdk/locales/[locale].json",
        "packages/oauth-client/locales/[locale].json",
        "packages/shared-i18n/locales/[locale].json",
        "packages/shared/locales/[locale].json",
        "packages/universal-cli-bridge/locales/[locale].json"
      ],
      "exclude": [
        "**/*test*",
        "**/*node_modules*",
        "**/*dist*",
        "**/*build*",
        "**/*.git*"
      ]
    }
  },
  "$schema": "https://lingo.dev/schema/i18n.json"
}