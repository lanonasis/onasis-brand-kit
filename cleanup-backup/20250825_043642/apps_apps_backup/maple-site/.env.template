# Maple Site Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase configuration - schema isolation compliant
VITE_SUPABASE_URL=https://your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Do NOT include service_role key in frontend code

# Project identification for logging
VITE_PROJECT_NAME=maple
VITE_PROJECT_SCOPE=maple

# Deployment settings
VITE_SITE_URL=https://maple.lanonasis.com

# Central Auth Gateway (control-room)
VITE_AUTH_GATEWAY_URL=http://localhost:4000
