# Lan Onasis Monorepo Environment Configuration Template
# Copy this file to .env and fill in the values

# Development Settings
NODE_ENV=development
DEBUG_I18N=false

# Router Configuration
ROUTER_PORT=3000
CONTROL_ROOM_PORT=4000

# Supabase Configuration (Primary Database)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=REDACTED_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=REDACTED_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REDACTED_SUPABASE_SERVICE_ROLE_KEY

# AI Providers Configuration
OPENAI_API_KEY=REDACTED_OPENAI_API_KEY
OPENAI_ORG_ID=your-org-id-here
ANTHROPIC_API_KEY=REDACTED_ANTHROPIC_API_KEY
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Internationalization Configuration
LINGO_API_KEY=your-lingo-api-key-here
LINGO_PROJECT_ID=your-lingo-project-id-here
I18N_QUALITY_THRESHOLD=90
I18N_COVERAGE_THRESHOLD=95
I18N_MAX_RETRIES=3

# Monitoring and Alerts
I18N_WEBHOOK_URL=your-slack-webhook-url-here
I18N_ALERT_THRESHOLD=70

# JWT Configuration
JWT_SECRET=REDACTED_JWT_SECRET

# SD-Ghost Protocol Configuration
SD_GHOST_VPS_URL=http://your-sd-ghost-vps-url:3000
SD_GHOST_SUPABASE_URL=https://<project-ref>.supabase.co

# Onasis-CORE Partnership Management
ONASIS_SUPABASE_URL=https://<project-ref>.supabase.co
ONASIS_SUPABASE_SERVICE_KEY=REDACTED_SUPABASE_SERVICE_ROLE_KEY
