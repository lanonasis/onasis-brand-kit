# Add directories or file patterns to ignore during indexing (e.g. foo/ or *.csv)

# Ignore build outputs and dependencies
node_modules/
dist/
build/
.next/
.turbo/
coverage/

# Ignore OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Ignore logs and temporary files
*.log
*.tmp
.cache/

# Ignore environment files
.env
.env.local
.env.*.local

# Ignore lock files (keep package.json but ignore lock files for better indexing)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Ignore backup and temporary directories
backup/
temp/
tmp/

# Ignore specific large directories that might cause issues
separated-repos/
