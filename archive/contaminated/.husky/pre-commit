#!/usr/bin/env sh

echo "🔍 Running pre-commit checks..."

# Initialize submodules if needed (for brand-kit assets)
echo "📦 Checking submodules..."
git submodule update --init --recursive || echo "⚠️  Submodule initialization skipped"

# Run linting across all packages (continue even if some fail)
echo "📝 Running linting..."
bun run lint || echo "⚠️  Some packages have linting issues (continuing...)"

# Run type checking (continue even if some fail)
echo "🔍 Running type checking..."
bun run build --dry-run || echo "⚠️  Some packages have type issues (continuing...)"

# Run i18n validation
echo "🌐 Running i18n validation..."
bun run i18n:validate || echo "⚠️  i18n validation failed (continuing...)"

echo "✅ Pre-commit checks completed!"
