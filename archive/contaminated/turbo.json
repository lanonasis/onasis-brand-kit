{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "dependsOn": ["^dev"]
    },
    "build": {
      "outputs": [".next/**", "dist/**", "build/**"],
      "dependsOn": ["^build"]
    },
    "start": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "i18n": {
      "cache": false,
      "outputs": ["**/locales/**"],
      "dependsOn": ["^i18n"]
    },
    "deploy": {
      "cache": false,
      "outputs": []
    }
  },
  "globalDependencies": [
    "packages/brand-kit/**"
  ]
}