{
    // @ts-nocheck
    "github.copilot.nextEditSuggestions.enabled": true,
    "css.validate": false,
    "less.validate": false,
    "scss.validate": false,
    "css.customData": [".vscode/css_custom_data.json"],
    "tailwindCSS.includeLanguages": {
        "css": "css",
        "scss": "scss",
        "less": "less"
    },
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "postman.settings.dotenv-detection-notification-visibility": false,
    "eslint.debug": true,
    "eslint.format.enable": true,
    "eslint.lintTask.enable": true,
    "accessibility.voice.autoSynthesize": "on",
    "accessibility.voice.ignoreCodeBlocks": true,
    "vercelVSCode.accessToken": "nRLgjJ3coaOf4xF1n6369HKS",
    
    // MCP Configuration
    "mcp.enabled": true,
    "mcp.configPath": ".vscode/mcp.json",
    "mcp.autoConnect": false,
    "mcp.servers": {
        "lanonasis": {
            "enabled": true,
            "command": "node",
            "args": ["${workspaceFolder}/apps/lanonasis-maas/mcp-server/dist/unified-mcp-server.js"],
            "env": {
                "NODE_ENV": "development"
            }
        }
    }
}