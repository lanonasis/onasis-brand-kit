{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "dev": {
      "cache": false,
      "dependsOn": ["^dev"]
    },
    "build": {
      "outputs": [".next/**", "dist/**"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "i18n": {
      "cache": false,
      "outputs": ["**/locales/**"],
      "dependsOn": ["^i18n"]
    },
    "memory-service#dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "SUPABASE_URL=https://<project-ref>.supabase.co
        "SUPABASE_ANON_KEY=REDACTED_SUPABASE_ANON_KEY
        "SUPABASE_SERVICE_KEY=REDACTED_SUPABASE_SERVICE_ROLE_KEY
        "OPENAI_API_KEY=REDACTED_OPENAI_API_KEY
        "JWT_SECRET=REDACTED_JWT_SECRET
      ]
    },
    "memory-service#build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "memory-service#test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "@lanonasis/cli#build": {
      "outputs": ["dist/**"],
      "dependsOn": ["@lanonasis/memory-service#build"]
    },
    "@lanonasis/memory-client#build": {
      "outputs": ["dist/**", "lib/**"]
    },
    "lanonasis-memory#build": {
      "outputs": ["out/**", "*.vsix"],
      "dependsOn": ["@lanonasis/memory-client#build"]
    }
  }
}