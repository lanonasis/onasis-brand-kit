{
  "name": "@lanonasis/brand-kit",
  "version": "1.1.0",
  "description": "Complete brand assets for LAN Onasis — logos, favicons, app icons, social media templates, and CSS design tokens. Fully automated build pipeline.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/",
    "01_LOGOS/",
    "02_FAVICONS/",
    "03_SOCIAL_MEDIA/",
    "04_EMAIL_SIGNATURES/",
    "05_DEVELOPER_ASSETS/",
    "06_BRAND_GUIDELINES/",
    "07_APP_ICONS/",
    "campaigns/",
    "marketing/",
    "social-media/",
    "web-assets/",
    "documentation/",
    "source/svg-sources/",
    "ASSET_STATUS.md",
    "README.md"
  ],
  "style": "dist/brand.css",
  "exports": {
    ".": {
      "import": "./dist/brand.css",
      "default": "./dist/brand.css"
    },
    "./css": "./dist/brand.css",
    "./logos": "./01_LOGOS/",
    "./favicons": "./02_FAVICONS/",
    "./app-icons": "./07_APP_ICONS/",
    "./social-media": "./social-media/"
  },
  "scripts": {
    "build:css": "mkdir -p dist && cp source/design-system/colors_and_type.css dist/brand.css",
    "build:assets": "node scripts/build-assets.js",
    "build:social-pack": "node scripts/build-social-pack.js",
    "build": "bun run build:css && bun run build:assets",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lanonasis/onasis-brand-kit.git"
  },
  "homepage": "https://github.com/lanonasis/onasis-brand-kit#readme",
  "bugs": {
    "url": "https://github.com/lanonasis/onasis-brand-kit/issues"
  },
  "keywords": [
    "brand",
    "brand-kit",
    "assets",
    "logos",
    "favicons",
    "app-icons",
    "social-media",
    "css-variables",
    "design-system",
    "design-tokens",
    "lanonasis",
    "lan-onasis",
    "africa",
    "saas",
    "fintech"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.0.25",
  "devDependencies": {
    "sharp": "^0.34.5",
    "svgo": "^4.0.1"
  }
}