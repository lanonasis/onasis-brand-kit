{
  "name": "@lanonasis/brand-kit",
  "version": "0.1.1",
  "description": "Reusable brand assets (favicons, app icons, social media templates) and CSS variables for Lan Onasis projects.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/",
    "02_FAVICONS/",
    "03_SOCIAL_MEDIA/",
    "05_DEVELOPER_ASSETS/",
    "07_APP_ICONS/",
    "documentation/"
  ],
  "style": "dist/brand.css",
  "exports": {
    ".": {
      "import": "./dist/brand.css",
      "default": "./dist/brand.css"
    }
  },
  "scripts": {
    "build": "mkdir -p dist && cp src/brand.css dist/brand.css",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lanonasis/onasis-brand-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.0.25"
}
