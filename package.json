{
  "name": "@lanonasis/brand-kit",
  "version": "1.0.1",
  "description": "Complete brand assets package for LAN Onasis - logos, favicons, app icons, social media templates, and CSS variables.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/",
    "01_LOGOS/",
    "02_FAVICONS/",
    "03_SOCIAL_MEDIA/",
    "04_EMAIL_SIGNATURES/",
    "05_DEVELOPER_ASSETS/",
    "06_BRAND_GUIDELINES/",
    "07_APP_ICONS/",
    "campaigns/",
    "marketing/",
    "social-media/",
    "web-assets/",
    "documentation/",
    "ASSET_STATUS.md",
    "BRANCH_PROTECTION_GUIDE.md",
    "README.md"
  ],
  "style": "dist/brand.css",
  "exports": {
    ".": {
      "import": "./dist/brand.css",
      "default": "./dist/brand.css"
    }
  },
  "scripts": {
    "build": "mkdir -p dist && cp src/brand.css dist/brand.css",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lanonasis/onasis-brand-kit.git"
  },
  "keywords": [
    "brand",
    "assets",
    "logos",
    "favicons",
    "app-icons",
    "social-media",
    "css-variables",
    "design-system",
    "lanonasis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.0.25"
}