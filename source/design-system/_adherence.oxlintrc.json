{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/Badge/**",
              "components/BrandMark/**",
              "components/Button/**",
              "components/Card/**",
              "components/L0Mark/**",
              "ui_kits/dashboard/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Plus Jakarta Sans|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Plus Jakarta Sans, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|info|warning|danger|neutral|gold)$/]",
        "message": "<Badge> tone must be one of 'success' | 'info' | 'warning' | 'danger' | 'neutral' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|theme|size|basePath|className|style|alt|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: variant, theme, size, basePath, className, style, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:icon|monogram|wordmark|tile)$/]",
        "message": "<BrandMark> variant must be one of 'icon' | 'monogram' | 'wordmark' | 'tile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<BrandMark> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|onClick|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children, onClick, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|body|accent|footer|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: eyebrow, title, body, accent, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:gold|green)$/]",
        "message": "<Card> accent must be one of 'gold' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='L0Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|meridian|accent|className|style|alt|key|ref|className|style|children)$/]",
        "message": "<L0Mark> doesn't accept that prop. Declared props: variant, size, meridian, accent, className, style, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='L0Mark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:circle|ellipse)$/]",
        "message": "<L0Mark> variant must be one of 'circle' | 'ellipse'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
